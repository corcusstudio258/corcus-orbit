# ---------- App ----------
PORT=5000
NODE_ENV=development
# Long random string — change this in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d
# Public URL of the app (used in WhatsApp message links)
APP_URL=http://localhost:5173
# Comma-separated origins allowed to call the API in development
CORS_ORIGIN=http://localhost:5173
TZ_NAME=Asia/Kolkata

# ---------- Database ----------
# sqlite (zero setup, good for local) or mysql (production / Hostinger)
DB_DIALECT=sqlite
DB_STORAGE=./data/orbit.sqlite
# MySQL settings (used when DB_DIALECT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=orbit
DB_USER=root
DB_PASS=

# ---------- WhatsApp ----------
# Configure WhatsApp from Settings > WhatsApp inside the app.
# Values below are only used as defaults when nothing is saved in Settings.
WA_PROVIDER=log
WA_META_TOKEN=
WA_META_PHONE_ID=
